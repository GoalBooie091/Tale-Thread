<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); min-height: 100vh; padding: 20px; }
    .container { max-width: 1200px; margin: 0 auto; }
    header { background: white; padding: 20px 30px; border-radius: 10px; box-shadow: 0 4px 15px rgba(0,0,0,0.1); margin-bottom: 30px; display: flex; justify-content: space-between; align-items: center; }
    h1 { color: #667eea; }
    .user-info { display: flex; align-items: center; gap: 15px; }
    .btn { padding: 10px 20px; border: none; border-radius: 5px; cursor: pointer; font-size: 14px; transition: all 0.3s; }
    .btn-primary { background: #667eea; color: white; }
    .btn-primary:hover { background: #764ba2; }
    .btn-secondary { background: #e74c3c; color: white; }
    .content { display: grid; grid-template-columns: 2fr 1fr; gap: 30px; }
    .card { background: white; padding: 25px; border-radius: 10px; box-shadow: 0 4px 15px rgba(0,0,0,0.1); }
    .card h2 { color: #333; margin-bottom: 15px; }
    .story-item { border-left: 4px solid #667eea; padding: 15px; margin-bottom: 15px; background: #f8f9fa; border-radius: 5px; }
    .story-item h3 { color: #667eea; margin-bottom: 10px; font-size: 16px; }
    .story-item p { color: #666; font-size: 14px; line-height: 1.6; }
    .story-meta { font-size: 12px; color: #999; margin-top: 10px; }
    .features { display: flex; flex-direction: column; gap: 15px; }
    .feature-item { padding: 15px; background: #f8f9fa; border-radius: 8px; }
    .feature-item h3 { color: #667eea; margin-bottom: 5px; }
    .feature-item p { color: #666; font-size: 14px; }
    .auth-section { text-align: center; padding: 40px; }
    .auth-section p { color: #666; margin-bottom: 20px; }
    .login-form { display: flex; flex-direction: column; gap: 15px; max-width: 400px; margin: 0 auto; }
    .login-form input { padding: 12px; border: 1px solid #ddd; border-radius: 5px; font-size: 14px; }
  </style>
</head>
<body>
  <div class="container">
    <header>
      <h1>📖 StoryCrafter AI</h1>
      <div class="user-info">
        <% if (user) { %>
          <span>Welcome, <strong><%= user.username %></strong>!</span>
          <button class="btn btn-secondary" onclick="logout()">Logout</button>
        <% } else { %>
          <button class="btn btn-primary" onclick="showLogin()">Login</button>
        <% } %>
      </div>
    </header>

    <div class="content">
      <div class="card">
        <h2>📚 Recent Stories</h2>
        <% if (stories.length > 0) { %>
          <% stories.forEach(story => { %>
            <div class="story-item">
              <h3>"<%= story.prompt.substring(0, 50) %>..."</h3>
              <p><%= story.storyText.substring(0, 200) %>...</p>
              <div class="story-meta">
                By <%= story.author ? story.author.username : 'Anonymous' %> • <%= new Date(story.createdAt).toLocaleDateString() %>
              </div>
            </div>
          <% }); %>
        <% } else { %>
          <p style="color: #666;">No stories generated yet. Login to create your first story!</p>
        <% } %>
      </div>

      <div class="card features">
        <h2>✨ Features</h2>
        <div class="feature-item">
          <h3>🎨 AI-Powered Stories</h3>
          <p>Generate unique stories with cutting-edge AI technology</p>
        </div>
        <div class="feature-item">
          <h3>🔐 JWT Authentication</h3>
          <p>Secure login with JSON Web Tokens</p>
        </div>
        <div class="feature-item">
          <h3>🔌 Real-time Socket.io</h3>
          <p>Live story generation updates</p>
        </div>
        <div class="feature-item">
          <h3>📄 Server-Side Rendering</h3>
          <p>Fast page loads with SSR technology</p>
        </div>
      </div>
    </div>
  </div>

  <script src="/socket.io/socket.io.js"></script>
  <script>
    const socket = io();
    
    socket.on("connect", () => {
      console.log("Connected to Socket.io server");
    });

    socket.on("new-story", (story) => {
      console.log("New story generated:", story);
      alert("New story generated by " + story.author + "!");
    });

    function logout() {
      fetch("/api/auth/logout", { method: "POST", credentials: "include" })
        .then(() => window.location.reload())
        .catch(err => console.error("Logout error:", err));
    }

    function showLogin() {
      alert("Please use the login page to authenticate");
      window.location.href = "/login.html";
    }
  </script>
</body>
</html>