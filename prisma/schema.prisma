datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        Int      @id @default(autoincrement())
  username  String
  email     String   @unique
  password  String
  stories   Story[]
  createdAt DateTime @default(now())
}

model Story {
  id         Int      @id @default(autoincrement())
  prompt     String
  storyText  String
  references Json     @default("[]")
  authorId   Int?
  author     User?    @relation(fields: [authorId], references: [id])
  createdAt  DateTime @default(now())
}
